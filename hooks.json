{
  "reminder": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python scripts/pre_reminder.py"
      }
    ]
  },
  "agent-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/guard_agent_skill.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
